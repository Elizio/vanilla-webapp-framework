{
  "name": "vanilla-webapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:coverage": "vitest run --pool=threads --poolOptions.threads.singleThread=true --coverage",
    "lint": "cd .. && npx --prefix frontend biome check --config-path=biome.json",
    "format": "cd .. && npx --prefix frontend biome check --write --config-path=biome.json",
    "format:check": "cd .. && npx --prefix frontend biome format --check --config-path=biome.json"
  },
  "dependencies": {
    "alpinejs": "^3.17.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/forms": "^0.5.11",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.6.2",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.5",
    "vitest": "^2.1.0"
  }
}
