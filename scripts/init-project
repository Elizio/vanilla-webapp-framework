#!/usr/bin/env python3
"""Rewrite template placeholders for a new project and optionally run checks."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

PLACEHOLDERS_REL = Path("docs") / "template-placeholders.md"
SKIP_DIR_NAMES = {
    ".git",
    ".venv",
    "node_modules",
    ".tools",
    "__pycache__",
    ".pytest_cache",
    ".ruff_cache",
    ".mypy_cache",
    "htmlcov",
    "backend/static",
}
SKIP_SUFFIXES = {
    ".pyc",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
}
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,48}$")
KEY_RE = re.compile(r"^([A-Z][A-Z0-9_]+)=(.*)$")


def parse_placeholders(text: str) -> dict[str, str]:
    """Return KEY=value pairs from the fenced block in the placeholders doc."""
    found: dict[str, str] = {}
    in_fence = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped == "```":
            in_fence = not in_fence
            continue
        if not in_fence:
            continue
        match = KEY_RE.match(stripped)
        if match:
            found[match.group(1)] = match.group(2)
    return found


def render_placeholders(values: dict[str, str], body: str) -> str:
    """Rewrite the first fenced KEY=value block in ``body``."""
    lines = body.splitlines(keepends=True)
    out: list[str] = []
    in_fence = False
    replaced = False
    for line in lines:
        if line.strip() == "```":
            out.append(line)
            if in_fence:
                in_fence = False
            elif not replaced:
                in_fence = True
                for key, value in values.items():
                    out.append(f"{key}={value}\n")
                replaced = True
            continue
        if in_fence:
            continue
        out.append(line)
    return "".join(out)


def new_values(name: str) -> dict[str, str]:
    """Build replacement values for ``make init NAME=...``."""
    title = name.replace("-", " ").title()
    return {
        "PROJECT_SLUG": name,
        "PROJECT_TITLE": title,
        "FRONTEND_PACKAGE": f"{name}-frontend",
        "IMAGE_NAME": f"YOUR_GHCR_OWNER/{name}",
        "PUBLIC_HOST": "example.test",
        # Keep a distinct subpath so cookie Path=/ vs Path=/<slug> tests
        # still pass after rewrite. Operators can set APP_BASE_PATH=/ later.
        "APP_SUBPATH": f"/{name}",
        "HOSTINGER_VM": "YOUR_VM_ID",
        "HOSTINGER_PROJECT": "YOUR_PROJECT",
        "GITHUB_OWNER": "YOUR_GITHUB",
        "SETUP_AUTHOR": "YOUR_NAME",
        "SETUP_EMAIL": "YOUR_NAME@example.com",
        "SETUP_URL": f"https://github.com/YOUR_GITHUB/{name}",
    }


def iter_text_files(root: Path) -> list[Path]:
    """Return text files under ``root`` that should be rewritten."""
    found: list[Path] = []
    static_dir = root / "backend" / "static"
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        rel_parts = set(path.relative_to(root).parts)
        if rel_parts & SKIP_DIR_NAMES:
            continue
        if static_dir in path.parents or path == static_dir:
            continue
        if path.suffix.lower() in SKIP_SUFFIXES:
            continue
        found.append(path)
    return found


def replace_in_tree(root: Path, mapping: list[tuple[str, str]]) -> int:
    """Replace old→new strings in text files. Returns files changed."""
    changed = 0
    for path in iter_text_files(root):
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        updated = text
        for old, new in mapping:
            if old:
                updated = updated.replace(old, new)
        if updated != text:
            path.write_text(updated, encoding="utf-8")
            changed += 1
    return changed


def reset_project_docs(root: Path) -> None:
    """Drop this repo's dated plans so a fork starts clean."""
    for sub in ("plans", "specs"):
        folder = root / "docs" / "superpowers" / sub
        if folder.is_dir():
            shutil.rmtree(folder)
    readme = root / "docs" / "superpowers" / "README.md"
    readme.parent.mkdir(parents=True, exist_ok=True)
    readme.write_text(
        "# Plans\n\nAdd design specs and implementation plans for this project here.\n",
        encoding="utf-8",
    )
    stray = root / "vibe-prompts-examples" / "temp.txt"
    if stray.is_file():
        stray.unlink()


MIN_LEFTOVER_LEN = 4


def leftover_needles(old: dict[str, str], new: dict[str, str]) -> list[str]:
    """Old placeholder values that should not remain after a rewrite.

    Skips values shorter than ``MIN_LEFTOVER_LEN`` (a new ``APP_SUBPATH=/``
    would otherwise match every path) and values that are unchanged in
    ``new`` (a second ``make init`` keeps ``example.test`` / ``YOUR_NAME``).
    """
    unchanged = {value.lower() for value in new.values() if value}
    needles: list[str] = []
    for value in old.values():
        if len(value) < MIN_LEFTOVER_LEN:
            continue
        if value.lower() in unchanged:
            continue
        needles.append(value)
    return needles


def leftover_hits(root: Path, needles: list[str]) -> list[str]:
    """Return ``path:line`` hits for leftover template names."""
    hits: list[str] = []
    lowered = [(needle, needle.lower()) for needle in needles if needle]
    for path in iter_text_files(root):
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        for lineno, line in enumerate(text.splitlines(), start=1):
            hay = line.lower()
            for _orig, low in lowered:
                if low and low in hay:
                    rel = path.relative_to(root).as_posix()
                    hits.append(f"{rel}:{lineno}:{line.strip()}")
                    break
    return hits


def main(argv: list[str] | None = None) -> int:
    """Rewrite placeholders, reset plans, and optionally run ``make check``.

    Args:
        argv: CLI arguments (defaults to ``sys.argv[1:]``).

    Returns:
        Process exit code.
    """
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--name", required=True, help="New project slug (lowercase)")
    parser.add_argument(
        "--root",
        default=".",
        help="Project root (default: current directory)",
    )
    parser.add_argument(
        "--skip-check",
        action="store_true",
        help="Do not run make check after rewriting",
    )
    args = parser.parse_args(argv)
    if not NAME_RE.match(args.name):
        print(
            f"error: NAME must match {NAME_RE.pattern} (got {args.name!r})",
            file=sys.stderr,
        )
        return 2

    root = Path(args.root).resolve()
    placeholders_path = root / PLACEHOLDERS_REL
    if not placeholders_path.is_file():
        print(f"error: missing {placeholders_path}", file=sys.stderr)
        return 2

    current = parse_placeholders(placeholders_path.read_text(encoding="utf-8"))
    required = {
        "PROJECT_SLUG",
        "PROJECT_TITLE",
        "FRONTEND_PACKAGE",
        "IMAGE_NAME",
        "PUBLIC_HOST",
        "APP_SUBPATH",
        "HOSTINGER_VM",
        "HOSTINGER_PROJECT",
        "GITHUB_OWNER",
        "SETUP_AUTHOR",
        "SETUP_EMAIL",
        "SETUP_URL",
    }
    missing = sorted(required - set(current))
    if missing:
        print(f"error: placeholders missing keys: {missing}", file=sys.stderr)
        return 2

    target = new_values(args.name)
    pairs: list[tuple[str, str]] = []
    seen_old: set[str] = set()
    for key, old in current.items():
        if key not in target or old in seen_old:
            continue
        seen_old.add(old)
        pairs.append((old, target[key]))
    mapping = sorted(pairs, key=lambda pair: len(pair[0]), reverse=True)
    changed = replace_in_tree(root, mapping)
    reset_project_docs(root)
    placeholders_path.write_text(
        render_placeholders(target, placeholders_path.read_text(encoding="utf-8")),
        encoding="utf-8",
    )

    hits = leftover_hits(root, leftover_needles(current, target))
    if hits:
        print("error: leftover template names:\n" + "\n".join(hits[:50]), file=sys.stderr)
        return 1

    print(f"rewrote {changed} files for NAME={args.name}")
    if args.skip_check:
        return 0
    # Rewrites can shorten quoted strings (for example PUBLIC_HOST → example.test).
    # Reformat so ``ruff format --check`` inside ``make check`` still passes.
    formatted = subprocess.run(["make", "format"], cwd=str(root), check=False)
    if formatted.returncode != 0:
        return formatted.returncode
    result = subprocess.run(["make", "check"], cwd=str(root), check=False)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
