root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{py,js,json,yml,yaml,toml}]
indent_style = space

[*.py]
indent_size = 4

[*.js]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.hbs]
# Alpine HTML fragments; not linted by Biome or Ruff.
indent_size = 4
