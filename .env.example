FLASK_SECRET=change-me
JWT_SECRET=change-me
DATABASE_URI=sqlite:///app.db
APP_PROFILE=development
# If production, EMAIL_BACKEND=console counts as unconfigured (same as
# APP_PROFILE=production). Prefer APP_PROFILE; this is a secondary marker.
# ENV=
# Flask CLI entrypoint so `flask run` works from the repo root
FLASK_APP=backend.app

# PROJECT_FOLDER is only used when file logging is opted in and LOG_FILE is unset.
# It is the directory that contains (or is) the log folder; default is ~/project_folder.
# Default logging is stdout/stderr. Leave these unset in the container.
# PROJECT_FOLDER=/var/log/vanilla-webapp
# LOG_TO_FILE=1
# LOG_FILE=/var/log/vanilla-webapp/app.log

# Container listen port (HEALTHCHECK uses the same value)
# PORT=5000
# HEALTHCHECK_PATH=/api/health

# Optional: path to a custom env file (defaults to project root .env)
# ENV_FILE=/path/to/.env

# SEO toolbox: auth-first (default, noindex app pages) | public-first (indexable by default)
SEO_MODE=auth-first

# Frontend base path for subpath deployments (default: /). Set at image build time
# (docker-publish.yml passes VITE_BASE_PATH=/vanilla-webapp-framework/). Runtime
# compose cannot change the baked Vite base; rebuild the image instead.
# VITE_BASE_PATH=/

# Cookie Path for the namespaced auth, CSRF, and device cookies and the Flask
# session (default: /). Must match VITE_BASE_PATH without a trailing slash.
# Empty/unset keeps Path=/. Example: APP_BASE_PATH=/vanilla-webapp-framework
# APP_BASE_PATH=/

# Cookie names are prefixed so two apps on one host
# (dsfor.fun/vanilla-webapp-framework and dsfor.fun/garage-boss) do not share
# csrf_token / auth_token. COOKIE_PREFIX defaults to a slug of APP_NAME
# (vanilla-webapp-framework when APP_NAME is blank). Changing COOKIE_PREFIX
# (or APP_NAME when COOKIE_PREFIX is unset) logs everyone out. Leave the
# per-cookie overrides unset to use {COOKIE_PREFIX}_csrf_token and siblings.
# COOKIE_PREFIX=
# CSRF_COOKIE_NAME=
# AUTH_COOKIE_NAME=
# REFRESH_COOKIE_NAME=
# AUTH_DEVICE_COOKIE_NAME=

# Proxy configuration: trust X-Forwarded-* headers from reverse proxy (default: 0)
# Set TRUST_PROXY=1 when running behind Caddy, nginx, or similar with HTTPS termination.
# TRUST_PROXY_HOPS is how many proxy hops Flask should peel (default 1).
# It must equal the number of trusted proxies. Appending the connecting
# client to X-Forwarded-For is fine with x_for=1.
# TRUST_PROXY=0
# TRUST_PROXY_HOPS=1

# Auth rate limits (login + register). Shared in the app database across workers.
# Testing profile defaults RATELIMIT_ENABLED=0; production and development default on.
# RATELIMIT_ENABLED=1
# RATELIMIT_AUTH_IP_MAX=10
# RATELIMIT_AUTH_IP_WINDOW_SECONDS=60
# RATELIMIT_LOGIN_USER_MAX=5
# RATELIMIT_LOGIN_USER_WINDOW_SECONDS=900

# Session lifetimes. All optional; safe defaults. Access JWTs are short;
# refresh cookies last 24 h (session) or 30 days (remember me / OAuth).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_SESSION_TTL_HOURS=24

# HSTS (production only). Default on: max-age=31536000 without includeSubDomains.
# Keep enabled for at least one max-age after dropping includeSubDomains so
# browsers replace the cached policy (RFC 6797 §8.1). Then HSTS_ENABLED=0.
# HSTS_ENABLED=1

# Social login (optional — add keys for each provider you want to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# CORS: comma-separated browser origins only (scheme://host[:port], no paths).
# A path is stripped at startup with a warning. A malformed entry (no scheme/host)
# raises ValueError and stops startup. Defaults to the origin of FRONTEND_URL.
# CORS_ORIGINS=http://localhost:5173

# Full public app URL (keep the subpath here — OAuth/billing/email links need it).
# Production example: https://dsfor.fun/vanilla-webapp-framework
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE=http://localhost:5173

# Email sending (optional). Empty EMAIL_BACKEND: sign-up/login unchanged,
# password reset returns 503 EMAIL_NOT_CONFIGURED, nothing crashes.
# Dev/tests: EMAIL_BACKEND=console (in-memory outbox; no SMTP).
# Production treats console as unconfigured (same as empty EMAIL_BACKEND).
# Production (Resend): EMAIL_BACKEND=smtp, SMTP_HOST=smtp.resend.com,
# SMTP_PORT=465, SMTP_SECURITY=ssl, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<Resend API key>, EMAIL_FROM=no-reply@dsfor.fun
# EMAIL_BACKEND=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=ssl
# EMAIL_FROM=
# Display name for email, and the slug for namespaced session cookies.
# Two copies of this template on one host must set distinct APP_NAME values.
# APP_NAME=vanilla-webapp-framework
# REQUIRE_EMAIL_VERIFIED=1

# Production disables Swagger unless this is true/1/yes
# SWAGGER_ENABLED=false

# Billing (optional — checkout is disabled until API key + store id are set)
BILLING_PROVIDER=lemon_squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID_SUPPORTER=
